<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>FastCdc</RootNamespace>
		<AssemblyName>FastCdc</AssemblyName>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Title>FastCdc</Title>
		<Description>Content-defined chunking (FastCDC) for .NET</Description>
		<RepositoryUrl>https://github.com/Whaliin/fastcdc-net</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageVersion>2.0.1</PackageVersion>
		<Authors>Whaliin</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
